---
// Homepage: search first (H1 + search + popular searches), category tiles with product photos, today's biggest
// discounts, the most popular products, brands, shops, how the comparison works, magazine, SEO text and FAQ.
// Title, description, H1, the SEO text and the FAQ (FAQPage JSON-LD) are the texts Google knows — unchanged.
import Base from '../../layouts/Base.astro';
import Ik from '../Ik.astro';
import Karta from '../Karta.astro';
import PostKarta from '../PostKarta.astro';
import type { homeView } from '../../lib/views';
import { cislo, decode } from '../../lib/format';
import { picture } from '../../lib/img';
import { shopIcon, shopName } from '../../lib/shops';
import { BASE, OG_HOME } from '../../lib/site';
import { robots } from '../../lib/seo';

interface Props { v: Awaited<ReturnType<typeof homeView>> }
const { v } = Astro.props;
const title = 'Eroka.cz | Srovnání cen erotických pomůcek z ověřených eshopů';
const description = 'Porovnejte ceny tisíců erotických hraček z prověřených českých eshopů. Nakupujte chytře, výhodně a 100% diskrétně. Vibrátory, dilda, prádlo i kondomy.';
const celkem = cislo(Math.floor((v.home.products || 11000) / 1000) * 1000);
const TILES: Array<[string, string]> = [
	['vibratory', 'Vibrátory'], ['dilda', 'Dilda'], ['umele-vaginy-a-masturbatory', 'Masturbátory'], ['analni-koliky', 'Anální kolíky'],
	['tlakove-pomucky', 'Tlakové vibrátory'], ['damske-eroticke-pradlo', 'Dámské prádlo'], ['eroticke-pomucky-pro-pary', 'Pro páry'], ['lubrikacni-gely-a-oleje', 'Lubrikanty'],
	['kondomy', 'Kondomy'], ['fetis-kink', 'BDSM a fetiš'], ['venusiny-kulicky', 'Venušiny kuličky'], ['erekcni-krouzky-na-penis-a-varlata', 'Erekční kroužky'],
];
const tiles = TILES.map(([slug, label]) => { const c = v.tree.bySlug.get(slug); return c && c.count_total > 0 ? { slug, label, count: c.count_total, img: v.imgs[String(c.id)] } : null; }).filter((x): x is NonNullable<typeof x> => !!x);
const POPULAR: Array<[string, string]> = [['/znacka/satisfyer/', 'Satisfyer'], ['/vibratory/', 'vibrátor'], ['/umele-vaginy-a-masturbatory/', 'masturbátor'], ['/znacka/we-vibe/', 'We-Vibe'], ['/lubrikacni-gely-a-oleje/', 'lubrikační gel'], ['/znacka/lelo/', 'LELO'], ['/parove-vibratory/', 'pro páry']];
const popular = POPULAR.filter(([u]) => !u.startsWith('/znacka/') || v.brands.bySlug.has(u.split('/')[2]!));
const brands = v.home.brands.map(([id, n]) => { const b = v.brands.byId.get(id); return b ? { slug: b.slug, name: decode(b.name), n } : null; }).filter((x): x is NonNullable<typeof x> => !!x).slice(0, 12);
const shops = v.home.shops.filter(([, n]) => n >= 20).slice(0, 14);
const FAQ: Array<[string, string, string]> = [
	['Jak Eroka.cz vydělává a proč je pro mě zdarma?', 'Jsme affiliate srovnávač. Když přes nás přejdete k prodejci a nakoupíte, dostaneme malou provizi od eshopu. Vy nezaplatíte ani korunu navíc, ceny máte stejné jako přímo u prodejce.', 'Jsme affiliate srovnávač. Když přes nás přejdete k prodejci a nakoupíte, dostaneme malou provizi od eshopu. Vy nezaplatíte ani korunu navíc, ceny máte stejné jako přímo u prodejce.'],
	['Je doručení opravdu diskrétní?', 'Ano. Naši partnerští prodejci posílají zboží v neutrálním balení bez jakéhokoli loga či popisu obsahu. Na výpisu z účtu se neobjeví nic, co by prozradilo, co jste koupili.', 'Ano. Naši partnerští prodejci posílají zboží v neutrálním balení bez loga či popisu obsahu.'],
	['Z jakých eshopů porovnáváte ceny?', 'Spolupracujeme jen s ověřenými českými prodejci erotických pomůcek, jako je Růžový slon a Sexíček shop. Nabídku průběžně rozšiřujeme.', 'Spolupracujeme jen s ověřenými českými prodejci, jako je Růžový slon a Sexíček shop.'],
	['Jak najdu nejlevnější cenu?', 'U každého produktu zobrazujeme dostupné nabídky z různých eshopů. Stačí si vybrat tu nejvýhodnější a kliknutím přejít přímo k prodejci.', 'U každého produktu zobrazujeme nabídky z různých eshopů. Vyberete nejvýhodnější a kliknutím přejdete k prodejci.'],
];
const graph = [
	{ '@type': 'WebPage', '@id': BASE + '/#webpage', url: BASE + '/', name: title, isPartOf: { '@id': BASE + '/#website' }, about: { '@id': BASE + '/#organization' }, inLanguage: 'cs' },
];
const jsonLd = [
	{ '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: FAQ.map(([q, a]) => ({ '@type': 'Question', name: q, acceptedAnswer: { '@type': 'Answer', text: a } })) },
];
---
<Base title={title} description={description} canonical={BASE + '/'} robots={robots(false)} ogType="website" ogImage={OG_HOME} graph={graph} jsonLd={jsonLd} pageType="home" searchAction={true}>
	<section class="hero">
		<div class="w">
			<h1>Erotické pomůcky <em>výhodně</em> a 100% diskrétně</h1>
			<p class="hero__l">Porovnáváme ceny {celkem}+ produktů z ověřených českých e-shopů. Najděte, kde stejnou věc koupíte nejlevněji.</p>
			<div class="hs">
				<form class="hs__f" role="search" method="get" action="/" autocomplete="off">
					<label class="vh" for="hs-hero">Hledat produkt, značku nebo kategorii</label>
					<Ik id="hledat" />
					<input type="search" id="hs-hero" name="s" placeholder="Např. Satisfyer, vibrátor, lubrikační gel…" data-suggest enterkeyhint="search" />
					<button type="submit">Hledat</button>
				</form>
				<div class="hs__s" role="listbox" hidden></div>
			</div>
			<ul class="hero__q"><li>Často hledané:</li>{popular.map(([u, t]) => <li><a href={u}>{t}</a></li>)}</ul>
			<ul class="hero__s">
				<li><b class="num">{cislo(v.home.products)}</b> produktů s cenou</li>
				<li><b class="num">{cislo(v.home.offers)}</b> nabídek</li>
				<li><b class="num">{shops.length}</b> obchodů</li>
				<li>ceny aktualizujeme <b>každý den</b></li>
			</ul>
		</div>
	</section>

	<div class="w">
		<section class="sek" id="kategorie" aria-labelledby="h-kat">
			<div class="sek__h"><h2 id="h-kat">Kategorie</h2></div>
			<ul class="kt">
				{tiles.map((t, i) => { const im = picture(t.img, 160); return <li><a href={`/${t.slug}/`}>{im ? <img src={im.src} srcset={im.srcset} alt="" width="84" height="84" loading={i < 6 ? 'eager' : 'lazy'} decoding="async" /> : <span class="kt__x" />}<b>{t.label}</b><small>{cislo(t.count)} produktů</small></a></li>; })}
			</ul>
		</section>

		{v.deals.length > 0 && (
			<section class="sek" aria-labelledby="h-sl">
				<div class="sek__h"><h2 id="h-sl">Největší slevy dnes</h2><a href="/vibratory/?orderby=disc" rel="nofollow">Další slevy</a></div>
				<ul class="g g--6 sc">{v.deals.slice(0, 12).map((p) => <Karta p={p} />)}</ul>
			</section>
		)}

		{v.popular.length > 0 && (
			<section class="sek" aria-labelledby="h-pop">
				<div class="sek__h"><h2 id="h-pop">Nejoblíbenější produkty</h2></div>
				<ul class="g g--6">{v.popular.slice(0, 12).map((p) => <Karta p={p} />)}</ul>
			</section>
		)}

		{brands.length > 0 && (
			<section class="sek" aria-labelledby="h-zn">
				<div class="sek__h"><h2 id="h-zn">Oblíbené značky</h2></div>
				<ul class="zn">{brands.map((b) => <li><a href={`/znacka/${b.slug}/`}>{b.name}<small>{cislo(b.n)}</small></a></li>)}</ul>
			</section>
		)}

		<section class="sek" aria-labelledby="h-jak">
			<div class="sek__h"><h2 id="h-jak">Jak srovnáváme ceny</h2></div>
			<ol class="jak">
				<li><h3>Sbíráme nabídky</h3><p>Každou noc načteme aktuální ceny a dostupnost z {shops.length} ověřených českých e-shopů.</p></li>
				<li><h3>Párujeme stejné produkty</h3><p>Stejný výrobek od různých prodejců spojíme podle kódu EAN, takže vidíte všechny ceny vedle sebe.</p></li>
				<li><h3>Vy vyberete nejlevnější</h3><p>Kliknutím přejdete přímo do obchodu. Cena je stejná jako u prodejce, nic nepřiplácíte.</p></li>
			</ol>
		</section>

		{shops.length > 0 && (
			<section class="sek" aria-labelledby="h-ob">
				<div class="sek__h"><h2 id="h-ob">Obchody, které porovnáváme</h2></div>
				<ul class="ob">{shops.map(([d, n]) => <li><img src={shopIcon(d)} alt="" width="24" height="24" loading="lazy" decoding="async" /><div><b>{shopName(d)}</b><small>{cislo(n)} produktů</small></div></li>)}</ul>
			</section>
		)}

		{v.mag.length > 0 && (
			<section class="sek" aria-labelledby="h-mag">
				<div class="sek__h"><h2 id="h-mag">Rádce a magazín</h2><a href="/blog/">Všechny články</a></div>
				<ul class="pc pc--4">{v.mag.map((p) => <PostKarta p={p} h="h3" perex={false} />)}</ul>
			</section>
		)}

		<section class="sek seo">
			<h2>Erotické pomůcky a srovnání cen na jednom místě</h2>
			<p>Eroka.cz je nezávislý český srovnávač, který vám pomůže vybrat <strong>erotické pomůcky</strong> chytře a hlavně výhodně. Místo abyste obcházeli jeden eshop za druhým, porovnáme za vás ceny tisíců produktů z prověřených prodejců a ukážeme vám, kde stejnou hračku pořídíte nejlevněji. Nakupujete tak se stejným pohodlím jako v běžném sexshopu, ale s jistotou, že neplatíte ani korunu navíc.</p>
			<p>V nabídce najdete přes {celkem} produktů napříč všemi kategoriemi, od osvědčených klasik až po novinky. Ať hledáte první pomůcku, nebo rozšiřujete sbírku, vždy máte ceny i recenze přehledně na jednom místě. Naším cílem je, abyste se rozhodli rychle, bez trapasu a s dobrým pocitem z výhodného nákupu.</p>
			<h3>Co u nás porovnáte</h3>
			<p>Procházet můžete podle toho, co vás zajímá. Mezi nejoblíbenější kategorie patří <a href="/vibratory/">vibrátory</a>, <a href="/dilda/">dilda</a> a <a href="/umele-vaginy-a-masturbatory/">masturbátory a umělé vaginy</a>. Pro páry i jednotlivce máme <a href="/eroticke-pradlo/">erotické prádlo</a>, <a href="/vibracni-koliky-a-dalsi/">anální pomůcky</a> a <a href="/erekcni-krouzky-na-penis-a-varlata/">erekční kroužky</a>. Nechybí ani <a href="/kondomy/">kondomy</a> a <a href="/kosmetika-a-pece-o-telo/">lubrikační gely a kosmetika</a> pro bezpečné a příjemné chvíle.</p>
			<p>U každého produktu vidíte dostupné nabídky z různých eshopů, takže si snadno vyberete tu nejvýhodnější. Ceny se průběžně aktualizují, abyste měli vždy aktuální přehled.</p>
			<h3>Proč srovnávat ceny erotických pomůcek</h3>
			<p>Rozdíly v cenách stejné pomůcky u různých prodejců mohou být i několik set korun. U dražších značek, jako jsou prémiové vibrátory nebo interaktivní pomůcky, se vyplatí pár sekund porovnání ještě víc. Srovnávač vám tuhle práci udělá za vás a ukáže nejnižší cenu hned. Navíc spolupracujeme jen s ověřenými českými eshopy (například Růžový slon a Sexíček shop), takže nakupujete bezpečně a s důvěryhodnou zákaznickou podporou.</p>
			<h3>Diskrétnost na prvním místě</h3>
			<p>Veškeré zboží od našich partnerů přichází v neutrálním balení bez loga a popisu obsahu. Na výpisu z účtu ani na zásilce nepozná nikdo, co jste si objednali. Diskrétní doručení je u erotických pomůcek samozřejmostí a my klademe důraz na to, aby byl celý nákup pohodlný a soukromý.</p>
			<h3>Tipy, jak vybrat tu pravou pomůcku</h3>
			<p>Pokud si nejste jistí výběrem, mrkněte do našeho magazínu. Najdete v něm praktické průvodce bez mýtů a zbytečného studu, od výběru prvního dilda přes anální pomůcky pro začátečníky až po srovnání nejlepších masturbátorů. Dobře vybraná pomůcka vydrží roky a udělá radost, proto se vyplatí věnovat pár minut tomu, abyste koupili chytře a výhodně.</p>
		</section>

		<section class="sek faq" aria-labelledby="h-faq" style="max-width:860px">
			<h2 id="h-faq">Časté dotazy</h2>
			{FAQ.map(([q, a]) => <details><summary>{q}</summary><p>{a}</p></details>)}
		</section>
	</div>
</Base>
