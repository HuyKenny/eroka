	<section class="erk-sek erk-sek--sl">
		<div class="erk-wrap erk-wrap--uzky">
			<header class="erk-sek__hl">
				<span class="erk-stitek">Časté dotazy</span>
				<h2>Než se rozhodnete</h2>
			</header>
			<div class="erk-faq">
				{FAQ.map(([q, a], i) => <details open={i === 0}><summary>{q}</summary><p>{a}</p></details>)}
			</div>
		</div>
	</section>

	<section class="erk-final">
		<div class="erk-wrap">
			<h2>Objevte svět nekonečné rozkoše</h2>
			<p>Tisíce hraček, porovnané ceny a maximální diskrétnost. Začněte u kategorie, která vás láká nejvíc.</p>
			<a href="#kategorie" class="erk-tl erk-tl--zl">Procházet kategorie</a>
		</div>
	</section>
</div>
</Base>
