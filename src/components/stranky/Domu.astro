---
// Homepage v2 — port of weby/eroka/child-theme/front-page.php. H1/H2, SEO paragraphs, FAQ and JSON-LD are the texts
// of the old "domov" page (ID 11317) unchanged, so the platform switch does not touch what Google knows.
import Base from '../../layouts/Base.astro';
import Ik from '../Ik.astro';
import Mrizka from '../Mrizka.astro';
import type { homeView } from '../../lib/views';
import { cislo, decode, produktu } from '../../lib/format';
import { ASSETS, BASE, OG_HOME } from '../../lib/site';
import { robots } from '../../lib/seo';

interface Props { v: Awaited<ReturnType<typeof homeView>> }
const { v } = Astro.props;
const title = 'Eroka.cz | Srovnání cen erotických pomůcek z ověřených eshopů';
const description = 'Porovnejte ceny tisíců erotických hraček z prověřených českých eshopů. Nakupujte chytře, výhodně a 100% diskrétně. Vibrátory, dilda, prádlo i kondomy.';
const celkem = cislo(Math.floor(v.total / 100) * 100) + '+';
const pocet = (slug: string) => v.tree.bySlug.get(slug)?.count_total ?? 0;

/* Kategorie: slug, popisek, ikona, barvy (--ic / --ic2), krátký slogan */
const KATEGORIE: Array<[string, string, string, string, string, string]> = [
	['vibratory', 'Vibrátory', 'vibr', '#FFC9B5', '#FFD66B', 'Pro chvíle jen pro vás'],
	['eroticke-pradlo', 'Erotické prádlo', 'pradlo', '#E9DDF7', '#FFC9B5', 'Pro sebe i pro něj'],
	['kosmetika-a-pece-o-telo', 'Lubrikanty a kosmetika', 'lubr', '#D3EEDD', '#FFD66B', 'Gely, oleje, svíčky'],
	['dilda', 'Dilda', 'dildo', '#E9DDF7', '#FFD66B', 'Od skla po silikon'],
	['umele-vaginy-a-masturbatory', 'Masturbátory', 'mast', '#D3EEDD', '#FFC9B5', 'Něco pro něj'],
	['kondomy', 'Kondomy', 'kondom', '#FFC9B5', '#E9DDF7', 'Jistota na prvním místě'],
	['vibracni-koliky-a-dalsi', 'Anální pomůcky', 'anal', '#FFD66B', '#FFC9B5', 'Pro zvědavé'],
	['erekcni-krouzky-na-penis-a-varlata', 'Erekční kroužky', 'ring', '#FFD66B', '#D3EEDD', 'Pro páry'],
];
/* „Komu to kupujete?" — rozcestník podle toho, kdo dárek dostane */
const KOMU: Array<[string, string, string, string]> = [
	['/vibratory/', 'Pro sebe', 'sebe', '#FFC9B5'],
	['/parove-vibratory/', 'Pro nás dva', 'partner', '#E9DDF7'],
	['/umele-vaginy-a-masturbatory/', 'Pro něj', 'mast', '#D3EEDD'],
	['/eroticke-darky/', 'Jako dárek', 'darek', '#FFD66B'],
];
const FAQ: Array<[string, string, string]> = [
	['Jak Eroka.cz vydělává a proč je pro mě zdarma?', 'Jsme affiliate srovnávač. Když přes nás přejdete k prodejci a nakoupíte, dostaneme malou provizi od eshopu. Vy nezaplatíte ani korunu navíc, ceny máte stejné jako přímo u prodejce.', 'Jsme affiliate srovnávač. Když přes nás přejdete k prodejci a nakoupíte, dostaneme malou provizi od eshopu. Vy nezaplatíte ani korunu navíc, ceny máte stejné jako přímo u prodejce.'],
	['Je doručení opravdu diskrétní?', 'Ano. Naši partnerští prodejci posílají zboží v neutrálním balení bez jakéhokoli loga či popisu obsahu. Na výpisu z účtu se neobjeví nic, co by prozradilo, co jste koupili.', 'Ano. Naši partnerští prodejci posílají zboží v neutrálním balení bez loga či popisu obsahu.'],
	['Z jakých eshopů porovnáváte ceny?', 'Spolupracujeme jen s ověřenými českými prodejci erotických pomůcek, jako je Růžový slon a Sexíček shop. Nabídku průběžně rozšiřujeme.', 'Spolupracujeme jen s ověřenými českými prodejci, jako je Růžový slon a Sexíček shop.'],
	['Jak najdu nejlevnější cenu?', 'U každého produktu zobrazujeme dostupné nabídky z různých eshopů. Stačí si vybrat tu nejvýhodnější a kliknutím přejít přímo k prodejci.', 'U každého produktu zobrazujeme nabídky z různých eshopů. Vyberete nejvýhodnější a kliknutím přejdete k prodejci.'],
];
const graph = [
	{ '@type': 'WebPage', '@id': BASE + '/#webpage', url: BASE + '/', name: title, isPartOf: { '@id': BASE + '/#website' }, about: { '@id': BASE + '/#organization' }, inLanguage: 'cs' },
];
const jsonLd = [
	{ '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: FAQ.map(([q, , a]) => ({ '@type': 'Question', name: q, acceptedAnswer: { '@type': 'Answer', text: a } })) },
];
---
<Base title={title} description={description} canonical={BASE + '/'} robots={robots(false)} ogType="website" ogImage={OG_HOME} graph={graph} jsonLd={jsonLd} pageType="home" searchAction={true}>
<div class="erk-home">

	<section class="erk-hero" aria-labelledby="erk-h1">
		<div class="erk-wrap erk-hero__grid">
			<div class="erk-hero__txt">
				<span class="erk-stitek erk-stitek--nakl">★ Nezávislé srovnání cen z ověřených eshopů</span>
