					</ul>
				</div>
			</div>
			<div class="erk-hero__obr" aria-hidden="true">
				<div class="erk-kolaz">
					<span class="erk-kolaz__bl erk-kolaz__bl--a"><Ik id="vibr" size={120} /></span>
					<span class="erk-kolaz__bl erk-kolaz__bl--b"><Ik id="darek" size={96} /></span>
					<span class="erk-kolaz__bl erk-kolaz__bl--c"><Ik id="lubr" size={84} /></span>
					<span class="erk-kolaz__bl erk-kolaz__bl--d"><Ik id="pradlo" size={72} /></span>
					<span class="erk-kolaz__cena"><b>Cena vedle ceny</b><small>stejná hračka, víc eshopů</small></span>
				</div>
			</div>
		</div>
	</section>

	<div class="erk-duvera">
		<ul class="erk-wrap">
			<li><Ik id="balik" size={40} /><div><b>Diskrétní doprava</b><small>Neutrální balení bez loga</small></div></li>
			<li><Ik id="cena" size={40} /><div><b>Porovnání cen</b><small>Najdeme nejnižší cenu za vás</small></div></li>
			<li><Ik id="stit" size={40} /><div><b>Ověřená kvalita</b><small>Jen prověření prodejci</small></div></li>
		</ul>
	</div>

	<section class="erk-sek" id="kategorie">
