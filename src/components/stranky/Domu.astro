				<form class="erk-hledat erk-hledat--hero" role="search" method="get" action="/">
					<label class="screen-reader-text" for="erk-q-hero">Hledat pomůcku</label>
					<input type="search" id="erk-q-hero" name="s" placeholder="Hledejte: vibrátor, gel, prádlo…" />
