---
import Base from '../../layouts/Base.astro';
import Ik from '../Ik.astro';
const CATS: Array<[string, string]> = [['/vibratory/', 'Vibrátory'], ['/dilda/', 'Dilda'], ['/eroticke-pradlo/', 'Erotické prádlo'], ['/lubrikacni-gely-a-oleje/', 'Lubrikanty'], ['/kondomy/', 'Kondomy'], ['/blog/', 'Magazín']];
---
<Base title="Stránka nenalezena | Eroka" robots={['follow', 'noindex']} pageType="404">
	<div class="w e404">
		<h1>Tuhle stránku jsme nenašli</h1>
		<p class="intro" style="margin:0 auto">Možná se přesunula nebo už neexistuje. Zkuste vyhledávání, nebo začněte u kategorie.</p>
		<div class="hs">
			<form class="hs__f" role="search" method="get" action="/">
				<label class="vh" for="q404">Hledat</label><Ik id="hledat" />
				<input type="search" id="q404" name="s" placeholder="Hledat produkt, značku, kategorii…" />
				<button type="submit">Hledat</button>
			</form>
		</div>
		<ul class="hero__q" style="justify-content:center">{CATS.map(([u, t]) => <li><a href={u}>{t}</a></li>)}</ul>
	</div>
</Base>
