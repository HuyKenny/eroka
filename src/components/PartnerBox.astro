---
// "Ze Sbalit.cz" module under relationship articles (project Sbalit × Eroka). Map generated by
// scripts/portfolio/partner-map.py (astro) from seo/linkbuilding/partner-map.json. REL/WAVE = ERK_PARTNER_REL/_WAVE of WP.
import map from '../data/partner-map.json';
const REL = 'noopener';   // 'noopener' = dofollow (Kenny's choice "maximum"), 'nofollow noopener' switches it off
const WAVE = 1;           // highest active wave
interface Props { slug: string }
const m = (map as Record<string, { vlna: number; cile: Array<{ url: string; titulek: string; popis: string }> }>)[Astro.props.slug];
const cards = m && m.vlna <= WAVE ? m.cile : [];
---
{cards.length > 0 && (
	<aside class="pa" aria-label="Ze Sbalit.cz" data-partner="sbalit">
		<p class="pa__k">Partnerský web</p>
		<p class="pa__h">Ze Sbalit.cz: srovnání seznamek a rady o vztazích</p>
		<ul>
			{cards.map((c) => (
				<li><a href={c.url} target="_blank" rel={REL} data-partner-link="sbalit">
					<span class="pa__t">{c.titulek}</span>
					<span class="pa__d">{c.popis}</span>
					<span class="pa__go">Číst na Sbalit.cz →</span>
				</a></li>
			))}
		</ul>
	</aside>
)}
