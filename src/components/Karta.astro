---
// Product card (listing, brand, search, homepage, related). One offer → straight to the shop via /go/,
// more offers → "Porovnat N nabídek" on the product page (same rule as the WordPress v2 theme).
import Ik from './Ik.astro';
import type { Card } from '../lib/db';
import { cena, nabidek, decode } from '../lib/format';
import { imgUrl, validImage } from '../lib/img';

interface Props { p: Card; cat?: { slug: string; name: string } | undefined; idx?: number }
const { p, cat, idx = 99 } = Astro.props;
const name = decode(p.name);
const img = validImage(p.image);
const href = `/${p.slug}/`;
---
<li>
	<article class="erk-karta">
		<div class="erk-karta__obr">
			{img ? (
				<img src={imgUrl(img)} alt={name} width="300" height="300" loading={idx < 4 ? 'eager' : 'lazy'} fetchpriority={idx < 2 ? 'high' : undefined} decoding="async" />
			) : <Ik id="vibr" size={80} />}
		</div>
		{cat && <div class="erk-karta__kat"><a href={`/${cat.slug}/`} style="position:relative;z-index:2">{decode(cat.name)}</a></div>}
		<h3><a href={href}>{name}</a></h3>
		{p.best_domain && <p class="erk-karta__u">Nejlepší nabídka u: <b>{p.best_domain}</b></p>}
		<div class="erk-karta__spod">
			{p.min_price > 0 && <span class="erk-karta__cena">{p.offer_count > 1 && <small>od</small>}{cena(p.min_price)}</span>}
			{p.offer_count === 1 && p.go_slug ? (
				<a class="erk-karta__tl" href={`/go/${p.go_slug}/`} target="_blank" rel="nofollow sponsored" data-partner={p.best_domain} data-price={Math.round(p.min_price)}>Koupit</a>
			) : p.offer_count > 1 ? (
				<a class="erk-karta__tl erk-karta__tl--ob" href={href}>Porovnat {p.offer_count} {nabidek(p.offer_count)}</a>
			) : (
				<a class="erk-karta__tl erk-karta__tl--ob" href={href}>Zobrazit</a>
			)}
		</div>
	</article>
</li>
