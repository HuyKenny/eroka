---
// Icon from the inline sprite (data/ikony.svg, injected once by Base.astro) — erk_ikona() of the WP theme.
interface Props { id: string; size?: number; class?: string }
const { id, size = 48, class: cls = '' } = Astro.props;
---
<svg class={`ik ${cls}`.trim()} width={size} height={size} aria-hidden="true" focusable="false"><use href={`#i-${id}`} /></svg>
