---
// Desktop sidebar of listings: category links (children, or siblings for a leaf) + price filter (GET, cached by the
// middleware whitelist min_price/max_price). On mobile the same links are chips above the grid.
import type { Cat } from '../lib/db';
import { cislo } from '../lib/format';

interface Props { title: string; links: Cat[]; current?: number | undefined; action: string; min?: number | undefined; max?: number | undefined; sort: string }
const { title, links, current, action, min, max, sort } = Astro.props;
---
<aside class="erk-sb" aria-label="Filtry a kategorie">
	{links.length > 0 && (
		<div class="erk-sb__box">
			<p class="erk-sb__h">{title}</p>
			<ul>
				{links.map((c) => <li><a href={`/${c.slug}/`} aria-current={c.id === current ? 'page' : undefined}>{c.name}</a> <small>({cislo(c.count_total)})</small></li>)}
			</ul>
		</div>
	)}
	<div class="erk-sb__box">
		<p class="erk-sb__h">Cena</p>
		<form class="erk-cenaf" method="get" action={action}>
			<div><label for="erk-min">Od (Kč)</label><input id="erk-min" type="number" name="min_price" min="0" inputmode="numeric" value={min ?? ''} /></div>
			<div><label for="erk-max">Do (Kč)</label><input id="erk-max" type="number" name="max_price" min="0" inputmode="numeric" value={max ?? ''} /></div>
			{sort !== 'date' && <input type="hidden" name="orderby" value={sort} />}
			<button type="submit">Filtrovat</button>
			{(min !== undefined || max !== undefined) && <a href={action}>Zrušit filtr ceny</a>}
		</form>
	</div>
</aside>
