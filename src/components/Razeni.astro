---
import type { Sort } from '../lib/db';
interface Props { action: string; sort: Sort; min?: number | undefined; max?: number | undefined }
const { action, sort, min, max } = Astro.props;
const OPTS: Array<[Sort, string]> = [['date', 'Seřadit od nejnovějších'], ['popularity', 'Seřadit podle oblíbenosti'], ['price', 'Seřadit podle ceny: od nejnižší'], ['price-desc', 'Seřadit podle ceny: od nejvyšší']];
---
<form class="erk-razeni" method="get" action={action}>
	<label class="screen-reader-text" for="erk-orderby">Řazení</label>
	<select id="erk-orderby" name="orderby">
		{OPTS.map(([v, l]) => <option value={v} selected={v === sort}>{l}</option>)}
	</select>
	{min !== undefined && <input type="hidden" name="min_price" value={min} />}
	{max !== undefined && <input type="hidden" name="max_price" value={max} />}
	<button type="submit">Seřadit</button>
</form>
