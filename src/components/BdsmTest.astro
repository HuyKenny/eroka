---
// Interactive BDSM test (15. 11. 2026, "bdsm test" 4 200 searches/month). Rendered in place of the <!--bdsm-test--> marker
// in the article body (Clanek.astro). Runs only in the browser: answers are never stored or sent anywhere.
const OBLASTI = [
  { k: 'dom', n: 'Dominance' },
  { k: 'sub', n: 'Submise' },
  { k: 'bon', n: 'Bondage' },
  { k: 'smy', n: 'Smyslová hra' },
  { k: 'imp', n: 'Impact play' },
  { k: 'rol', n: 'Hra na role' },
];
