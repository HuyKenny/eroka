---
// Price history (daily minimum across shops) as a small inline SVG — replaces Content Egg's chart.js (201 kB).
// Fewer than two points = no chart (same rule as erk_opt_html on WordPress).
import { cena, datum } from '../lib/format';

interface Props { points: Array<{ day: string; min_price: number }>; name: string }
const { points, name } = Astro.props;
const W = 640, H = 220, P = { l: 56, r: 12, t: 14, b: 28 };
const pts = points.slice(-180);
const prices = pts.map((p) => p.min_price);
const lo = Math.min(...prices), hi = Math.max(...prices);
const span = hi - lo || Math.max(1, hi * 0.1);
const yMin = Math.max(0, lo - span * 0.15), yMax = hi + span * 0.15;
const t0 = Date.parse(pts[0]?.day ?? ''), t1 = Date.parse(pts[pts.length - 1]?.day ?? '');
const x = (d: string) => P.l + ((Date.parse(d) - t0) / Math.max(1, t1 - t0)) * (W - P.l - P.r);
const y = (v: number) => P.t + (1 - (v - yMin) / (yMax - yMin)) * (H - P.t - P.b);
// step line: the price holds until the next change
let d = '';
pts.forEach((p, i) => { d += i === 0 ? `M${x(p.day).toFixed(1)},${y(p.min_price).toFixed(1)}` : `H${x(p.day).toFixed(1)}V${y(p.min_price).toFixed(1)}`; });
const ticks = [yMin + (yMax - yMin) * 0.1, (yMin + yMax) / 2, yMax - (yMax - yMin) * 0.1];
const last = pts[pts.length - 1];
---
{pts.length >= 2 && (
	<div class="erk-graf">
		<svg viewBox={`0 0 ${W} ${H}`} role="img" aria-label={`Vývoj nejnižší ceny: ${name}, od ${cena(lo)} do ${cena(hi)}`}>
			{ticks.map((v) => (
				<g>
					<line x1={P.l} x2={W - P.r} y1={y(v)} y2={y(v)} stroke="#EBD9CC" stroke-width="1" />
					<text x={P.l - 8} y={y(v) + 4} text-anchor="end" font-size="12" fill="#6D5565">{Math.round(v)}</text>
				</g>
			))}
			<text x={P.l} y={H - 8} font-size="12" fill="#6D5565">{datum(pts[0]!.day)}</text>
			<text x={W - P.r} y={H - 8} font-size="12" fill="#6D5565" text-anchor="end">{datum(last!.day)}</text>
			<path d={d} fill="none" stroke="#C2255C" stroke-width="3" stroke-linejoin="round" />
			<circle cx={x(last!.day)} cy={y(last!.min_price)} r="5" fill="#C2255C" stroke="#3B1030" stroke-width="2" />
		</svg>
		<p class="erk-graf__cisla">
			<span>Nejnižší cena: <b>{cena(lo)}</b></span>
			<span>Nejvyšší cena: <b>{cena(hi)}</b></span>
			<span>Od: <b>{datum(pts[0]!.day)}</b></span>
		</p>
	</div>
)}
