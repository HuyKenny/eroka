---
// Header: logo, mega menu (one markup: desktop dropdown / mobile full screen, <details> works without JS), search with
// suggestions (/api/suggest, src/scripts/ui.ts) and a row of the main categories. Menu = data/menu.json (old WP menu 70).
import Ik from './Ik.astro';
import logo from '../data/logo.svg?raw';
import menu from '../data/menu.json';

interface Item { id: number; parent: number; title: string; url: string; order: number }
const items = (menu as Item[]).slice().sort((a, b) => a.order - b.order);
const tree = items.filter((i) => i.parent === 0).map((i) => ({ it: i, kids: items.filter((k) => k.parent === i.id) }));
const QUICK: Array<[string, string]> = [
	['/vibratory/', 'Vibrátory'], ['/dilda/', 'Dilda'], ['/umele-vaginy-a-masturbatory/', 'Masturbátory'], ['/eroticke-pradlo/', 'Erotické prádlo'],
	['/vibracni-koliky-a-dalsi/', 'Anální pomůcky'], ['/erekcni-krouzky-na-penis-a-varlata/', 'Erekční kroužky'], ['/parove-vibratory/', 'Pro páry'],
	['/lubrikacni-gely-a-oleje/', 'Lubrikanty'], ['/kondomy/', 'Kondomy'], ['/fetis-kink/', 'BDSM a fetiš'], ['/eroticke-darky/', 'Dárky'], ['/blog/', 'Magazín'],
];
const q = Astro.url.searchParams.get('s') ?? '';
---
<a class="skip" href="#obsah">Přeskočit na obsah</a>
<header class="hl">
	<div class="w hl__in">
		<details class="mm">
			<summary aria-label="Kategorie"><Ik id="menu" size={22} /><span class="mm__t">Kategorie</span></summary>
			<nav class="mm__p" aria-label="Kategorie">
				<div class="mm__top"><b>Kategorie</b><span class="mm__x" data-zavrit aria-label="Zavřít"><Ik id="zavrit" size={22} /></span></div>
				<div class="mm__g">
					{tree.map((n) => (
						<div class="mm__sk">
							<a href={n.it.url}>{n.it.title}</a>
							{n.kids.length > 0 && <ul>{n.kids.map((k) => <li><a href={k.url}>{k.title}</a></li>)}</ul>}
						</div>
					))}
					<div class="mm__sk"><a href="/eroticke-darky/">Erotické dárky</a><ul><li><a href="/blog/">Magazín a rady</a></li></ul></div>
				</div>
			</nav>
		</details>
		<a class="logo" href="/" aria-label="Eroka.cz — srovnání cen erotických pomůcek" set:html={logo} />
		<div class="hs">
			<form class="hs__f" role="search" method="get" action="/" autocomplete="off">
				<label class="vh" for="hs-q">Hledat produkt, značku nebo kategorii</label>
				<Ik id="hledat" />
				<input type="search" id="hs-q" name="s" value={q} placeholder="Hledat produkt, značku, kategorii…" data-suggest aria-autocomplete="list" aria-controls="hs-s" enterkeyhint="search" />
				<button type="submit">Hledat</button>
			</form>
			<div class="hs__s" id="hs-s" role="listbox" hidden></div>
		</div>
		<div class="hl__akce">
			<a class="hl__a" href="/blog/"><Ik id="mrizka" /><span>Magazín</span></a>
		</div>
	</div>
	<nav class="kn" aria-label="Hlavní kategorie">
		<ul>{QUICK.map(([u, t]) => <li><a href={u}>{t}</a></li>)}</ul>
	</nav>
</header>
