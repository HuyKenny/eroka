{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  // Since 23. 11. 2026 (Cloudflare Free plan) the frozen site links thumbnails on img.eroka.cz (R2 bucket eroka-thumbs, custom domain)
  // and this Worker only 301-redirects old /img/ URLs there (src/redirect.ts, ~1 ms CPU). The WASM resizer src/index.ts is kept for
  // rollback; its config (R2 binding THUMBS, RL_IMG ratelimit, CompiledWasm rules, secret IMG_SECRET) is in git history.
  // New thumbnails for a re-frozen site: scripts/cloudflare-free/img-na-r2.py in the workspace (makes the missing ones on Malina).
  "name": "eroka-img",
  "main": "./src/redirect.ts",
  "compatibility_date": "2026-10-01",
  "workers_dev": false,
  "preview_urls": false,
  "observability": { "enabled": true, "head_sampling_rate": 0.05 },
  "routes": [{ "pattern": "eroka.cz/img/*", "zone_name": "eroka.cz" }]
}
