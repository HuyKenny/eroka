{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  // Offer import Worker (src/index.ts). Secrets per environment (scripts/set-feed-secrets.py):
  //   IMPORT_SHARED_SECRET, FEED_URL_<n> for each Feed__n (URLs carry tokens).
  "name": "eroka-import-local",
  "main": "./src/index.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  // the Růžový slon feed (~12k items) is CPU heavy to parse
  "limits": { "cpu_ms": 300000 },
  "d1_databases": [{ "binding": "DB", "database_name": "eroka-local", "database_id": "00000000-0000-0000-0000-000000000000", "migrations_dir": "../../migrations" }],
  "r2_buckets": [{ "binding": "FEED_MIRROR", "bucket_name": "eroka-feeds" }],
  "triggers": { "crons": [] },
  "vars": {
    "ALLOWED_FEED_HOSTS": "affiliateport.scaletrk.com,feeds.mergado.com,flagranti.cz,storage.feedyio.com,store.virtshop.prod.inspishop.cz,vibratory.net,www.deeplove.cz,www.dialekarna.cz,www.erosstar.cz,www.lekarnaave.cz,www.ruzovyslon.cz,www.sexicekshop.cz,www.sexshop.cz,www.sexshop51.cz",
    "MAX_DROP_PCT": "40",
    "STALE_DAYS": "7"
  },
  "observability": { "enabled": true, "head_sampling_rate": 1 },
  "env": {
    "staging": {
      "name": "eroka-import-staging",
      // HTTP API protected by the bearer secret; no cron on staging (runs are triggered by hand: POST /tick)
      "workers_dev": true,
      "preview_urls": false,
      "triggers": { "crons": [] },
      "limits": { "cpu_ms": 300000 },
      "d1_databases": [{ "binding": "DB", "database_name": "eroka-staging", "database_id": "e70c0f9c-f877-4c4d-b2be-440c9e594633", "migrations_dir": "../../migrations" }],
      "r2_buckets": [{ "binding": "FEED_MIRROR", "bucket_name": "eroka-feeds" }],
      "vars": {
        "ALLOWED_FEED_HOSTS": "affiliateport.scaletrk.com,feeds.mergado.com,flagranti.cz,storage.feedyio.com,store.virtshop.prod.inspishop.cz,vibratory.net,www.deeplove.cz,www.dialekarna.cz,www.erosstar.cz,www.lekarnaave.cz,www.ruzovyslon.cz,www.sexicekshop.cz,www.sexshop.cz,www.sexshop51.cz",
        "MAX_DROP_PCT": "40",
        "STALE_DAYS": "7"
      }
    },
    "production": {
      "name": "eroka-import",
      "workers_dev": true,
      "preview_urls": false,
      // every 10 min between 01:00 and 05:50 UTC: 16 feeds one by one, then the day is finalised
      "triggers": { "crons": ["*/10 1-5 * * *"] },
      "limits": { "cpu_ms": 300000 },
      "d1_databases": [{ "binding": "DB", "database_name": "eroka-production", "database_id": "f62bfa2e-1e2c-4a3f-b100-f88220c25592", "migrations_dir": "../../migrations" }],
      "r2_buckets": [{ "binding": "FEED_MIRROR", "bucket_name": "eroka-feeds" }],
      "vars": {
        "ALLOWED_FEED_HOSTS": "affiliateport.scaletrk.com,feeds.mergado.com,flagranti.cz,storage.feedyio.com,store.virtshop.prod.inspishop.cz,vibratory.net,www.deeplove.cz,www.dialekarna.cz,www.erosstar.cz,www.lekarnaave.cz,www.ruzovyslon.cz,www.sexicekshop.cz,www.sexshop.cz,www.sexshop51.cz",
        "MAX_DROP_PCT": "40",
        "STALE_DAYS": "7"
      }
    }
  }
}
