{
  "$schema": "node_modules/wrangler/config-schema.json",
  // Top level = local development only (miniflare, local D1/R2).
  "name": "eroka-local",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  "assets": { "binding": "ASSETS", "directory": "./dist/client", "html_handling": "auto-trailing-slash", "not_found_handling": "none" },
  "services": [{ "binding": "IMG", "service": "eroka-img" }],
  "d1_databases": [{ "binding": "DB", "database_name": "eroka-local", "database_id": "00000000-0000-0000-0000-000000000000", "migrations_dir": "migrations" }],
  "ratelimits": [
    { "name": "RL_GO", "namespace_id": "74001", "simple": { "limit": 40, "period": 60 } },
    { "name": "RL_SEARCH", "namespace_id": "74003", "simple": { "limit": 90, "period": 60 } }
  ],
  "vars": { "ENVIRONMENT": "local", "SITE_URL": "http://localhost:8791", "ALLOWED_HOSTS": "localhost,127.0.0.1" },
  "observability": { "enabled": true, "head_sampling_rate": 1 },

  "env": {
    // Static build (Cloudflare Workers Free, 2026-11): rendered locally under `wrangler dev --local` over the SQLite state and
    // frozen into static files (scripts/static/build.py). Never deployed itself. Same vars as production so the HTML is identical;
    // no host allow-list, rate limits or services (local crawl).
    "render": {
      "name": "eroka-render",
      "workers_dev": false,
      "preview_urls": false,
      "d1_databases": [{ "binding": "DB", "database_name": "eroka-render", "database_id": "00000000-0000-0000-0000-000000000001", "migrations_dir": "migrations" }],
      "vars": {"ENVIRONMENT": "production", "SITE_URL": "https://eroka.cz", "ALLOWED_HOSTS": "", "REQUIRE_ACCESS_EVERYWHERE": "0", "ANALYTICS_ENABLED": "1"}
    },
    "staging": {
      "name": "eroka-staging",
      // eroka-staging.huy-kenny.workers.dev behind Cloudflare Access (whole host); the Worker re-checks the JWT.
      "workers_dev": true,
      "preview_urls": false,
      "services": [{ "binding": "IMG", "service": "eroka-img-staging" }],
      "d1_databases": [{ "binding": "DB", "database_name": "eroka-staging", "database_id": "e70c0f9c-f877-4c4d-b2be-440c9e594633", "migrations_dir": "migrations" }],
      "ratelimits": [
        { "name": "RL_GO", "namespace_id": "74011", "simple": { "limit": 40, "period": 60 } },
        { "name": "RL_SEARCH", "namespace_id": "74013", "simple": { "limit": 90, "period": 60 } }
      ],
      "vars": {
        "ENVIRONMENT": "staging",
        "SITE_URL": "https://eroka-staging.huy-kenny.workers.dev",
        "ALLOWED_HOSTS": "eroka-staging.huy-kenny.workers.dev",
        "REQUIRE_ACCESS_EVERYWHERE": "1",
        "ANALYTICS_ENABLED": "0",
        "ACCESS_TEAM_DOMAIN": "proud-pine-5d46.cloudflareaccess.com"
      }
      // secrets: ACCESS_AUD, IP_HASH_SALT
    },
    "production": {
      "name": "eroka",
      // Routes eroka.cz/* + www.eroka.cz/* are added at the cutover via the CF API (deleting them = instant rollback).
      "workers_dev": true,
      "preview_urls": false,
      "services": [{ "binding": "IMG", "service": "eroka-img" }],
      "d1_databases": [{ "binding": "DB", "database_name": "eroka-production", "database_id": "f62bfa2e-1e2c-4a3f-b100-f88220c25592", "migrations_dir": "migrations" }],
      "ratelimits": [
        { "name": "RL_GO", "namespace_id": "74021", "simple": { "limit": 40, "period": 60 } },
        { "name": "RL_SEARCH", "namespace_id": "74023", "simple": { "limit": 90, "period": 60 } }
      ],
      "vars": {
        "ENVIRONMENT": "production",
        "SITE_URL": "https://eroka.cz",
        "ALLOWED_HOSTS": "eroka.cz,www.eroka.cz,eroka.huy-kenny.workers.dev",
        "REQUIRE_ACCESS_EVERYWHERE": "0",
        "ANALYTICS_ENABLED": "1"
      }
    }
  }
}
